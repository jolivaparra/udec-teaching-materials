% ========== COLORES ==========
% Principales
\definecolor{UdeCPrincipal}{HTML}{223c6a}
\definecolor{UdeCSecundario}{HTML}{ffffff}
\definecolor{UdeCAcento}{HTML}{e69b0a}
\definecolor{UdeCAlerta}{HTML}{E74C3C}

% ========== VARIABLES DE DATOS ==========
\newcommand{\nombreAsignatura}{Nombre Asignatura}
\newcommand{\codigoAsignatura}{000000}
\newcommand{\infoSemestre}{20XX - X}
\newcommand{\nombreAyudante}{Nombre Ayudante}
\newcommand{\contactoAyudante}{example@email.com}


\newcommand{\asignatura}[2]{
    \renewcommand{\nombreAsignatura}{#1}
    \renewcommand{\codigoAsignatura}{#2}
}
\newcommand{\semestre}[1]{\renewcommand{\infoSemestre}{#1}}
\newcommand{\ayudante}[2]{
    \renewcommand{\nombreAyudante}{#1}
    \renewcommand{\contactoAyudante}{#2}
}

% ========== EXTRACCIÓN DE DATOS ==========
\IfFileExists{../infoAsignatura.tex}{%
    \input{../infoAsignatura.tex}%
}{%
    \PackageError{udec-core}{No se encontro 'infoAsignatura.tex' en la carpeta superior.}{Asegurate de que el archivo .tex este dentro de una subcarpeta (ej: psets/) y que infoAsignatura.tex este en la carpeta del ramo.}%
}

% ========== COMANDOS/MACROS ==========

% Divergencia / Divergence
\newcommand{\diver}[1]{\nabla\cdot\vect{#1}}

% Rotacional / Curl
\newcommand{\rot}[1]{\nabla\times\vect{#1}}

% Gradiente / Gradient
\newcommand{\grad}[1]{\nabla #1}

% Producto Interior / Dot Product
\newcommand{\dotprod}[2]{#1 \cdot #2}

% Notación Científica
\newcommand{\notcien}[2]{#1 \times 10^{#2}}


% ========== Bloques de Contenido ===========

% --- Lógica de compatibilidad Beamer/Article ---
\makeatletter
\@ifclassloaded{beamer}{\tcbset{beamerMode/.style={beamer}}}{\tcbset{beamerMode/.style={}}}
\makeatother

% --- Estilo ---
\tcbset{
    baseBox/.style={
            enhanced, breakable, beamerMode,
            colback=white,
            arc=1mm,
            boxrule=0.6pt,
            leftrule=4pt,
            fonttitle=\bfseries\normalsize,
            before skip=1.5em, after skip=1.5em,
            sharp corners=downhill,
            attach boxed title to top left={xshift=4mm, yshift=-3mm},
            coltitle=white,
            % --- AJUSTE DE PRECISIÓN ---
            top=10pt,                     % Espacio suficiente para no chocar con el título
            bottom=4pt,                   % Espacio mínimo necesario para que no se pegue abajo
            left=8pt, right=8pt,
            #1
        }
}

% 1. TEORÍA (Azul UdeC)
\newtcolorbox{boxTeoria}[2][]{
    baseBox={#1},
    colframe=UdeCPrincipal,
    title={#2},
    boxed title style={colback=UdeCPrincipal, sharp corners, rounded corners=northeast, arc=3mm}
}

% 2. ALERTA (Rojo Alerta)
\newtcolorbox{boxAlerta}[2][]{
    baseBox={#1},
    colframe=UdeCAlerta,
    title={#2},
    boxed title style={colback=UdeCAlerta, sharp corners, rounded corners=northeast, arc=3mm}
}

% 3. EJEMPLO (Acento UdeC)
\newtcolorbox{boxEjemplo}[2][]{
    baseBox={#1},
    colframe=UdeCAcento,
    title={#2},
    coltitle=black,
    boxed title style={colback=UdeCAcento, sharp corners, rounded corners=northeast, arc=3mm}
}

% 4. NOTA (Gris)
\newtcolorbox{boxNota}[2][]{
    baseBox={#1},
    colframe=gray!60,
    title={#2},
    boxed title style={colback=gray!60, sharp corners, rounded corners=northeast, arc=3mm}
}